{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TubeDesk",
  "version": "0.3.1",
  "identifier": "dev.tubedesk.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TubeDesk",
        "width": 1100,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "rpm",
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "category": "Music",
    "shortDescription": "Lightweight, audio-only YouTube Music client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3ODU1ODRFNEFEMTA1MDUKUldRRkJkRktUbGlGUjJ2WkdiZVM5U3I3MHBld2FjZUF6NXBFOHorZGpxd294YzJ6UmRGSkh5T2UK",
      "endpoints": [
        "https://github.com/0xZaphod/tubedesk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
